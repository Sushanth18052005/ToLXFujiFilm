# ---- Server ----
# Public base URL of the deployed site (used inside the QR codes). No trailing slash.
# MUST be https in production or phone cameras will refuse to open it.
BASE_URL=https://entry.example.com
PORT=3000

# Set to 1 when running behind a TLS-terminating proxy (Render, Railway, Nginx, etc.)
# so secure cookies work correctly.
TRUST_PROXY=1

# ---- Database (Postgres / Neon) ----
# Connection string for your Postgres database. On Neon: Dashboard → your project →
# Connection string (use the "pooled" connection). Keep this secret — never commit it.
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Force TLS for hosts not auto-detected (Neon/AWS/Render are detected automatically):
# PGSSL=require

# ---- Security ----
# Shared password staff type to unlock the scanner.
STAFF_PASSWORD=change-me-please
# Random string used to sign session cookies + tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-hex-string

# ---- Email (Brevo transactional HTTP API) ----
# Render's free tier blocks outbound SMTP, so QR passes are sent via Brevo's
# HTTPS API instead of Gmail/SMTP. Set up:
#   1. Create a free account at https://www.brevo.com (300 emails/day free).
#   2. Verify a sender: Senders, Domains & Dedicated IPs → Senders → add + verify
#      the address you'll send from (your Gmail works — click the confirmation link).
#   3. Create an API key: SMTP & API → API Keys → Generate a new key (v3).
BREVO_API_KEY=xkeysib-your-key-here
# The "from" address — MUST match the sender you verified in Brevo.
# Format: "Name <email>" or just the email.
MAIL_FROM="Traces of Lenses × Fujifilm <you@gmail.com>"
# Optional: sender email if MAIL_FROM has no <address> part.
# BREVO_SENDER=you@gmail.com

# ---- Event details (shown in the email; sensible defaults in lib/config.js) ----
EVENT_NAME=Interactive Photography Workshop
# EVENT_DATE=26 September 2026
# EVENT_TIME=12:00 PM – 5:00 PM
# EVENT_VENUE=Sardar Vallabhbhai Patel Auditorium, KMIT

# ---- Excel import ----
# Path to the registration spreadsheet.
REGISTRATIONS_FILE=./data/registrations.xlsx
